# No API key needed — this app uses your local Claude Code login (the same auth as
# your `claude` terminal). Just make sure `claude login` is done.
#
# Everything below is OPTIONAL. Copy to `.env` only if you want to override defaults.

# Port (default 3001)
# PORT=3001

# Interface to bind (default 127.0.0.1 — loopback only). The /api endpoints are
# unauthenticated and spend your Claude login's quota, so only widen this on a
# network you trust.
# HOST=127.0.0.1

# Path to the claude binary, if it isn't on PATH
# CLAUDE_BIN=/Users/you/.local/bin/claude

# Model to use (default claude-opus-4-8)
# CLAUDE_MODEL=claude-opus-4-8
